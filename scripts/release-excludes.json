{
  "_readme": "天命发版管线·单一真源排除清单。五条打包管线共用：①热更 web/tools/build-hot-update-package.js ②asar package.json build.files ③Capgo mobile/scripts/build-capgo-bundle.ps1 ④APK staging mobile/scripts/stage-web-for-cap.ps1 ⑤GitHub Pages scripts/stage-web-release.js。改排除规则只改这一处，避免各处手抄漂移。字段：dirs=按目录名排除；prefixes=按目录/文件名前缀排除；globs=按路径通配排除；previewMockup=只留 preview/img/ 运行素材，剔除设计稿、验证截图和下划线前缀脚本。",
  "dirs": ["_archive", "backups", "_screenshots", "test-results", "_codex_tmp", "dev-tools", "docs", "scripts", "tools", "godot", ".git", "node_modules", ".playwright-cli", ".cache", ".tmp", "tmp", "dist", "build", "release", "coverage", ".hot-update-staging", "_pw-scratch", "generated_images", ".vscode"],
  "prefixes": [".bak-", "_codex", ".git-defunct-"],
  "globs": ["**/*.bak*", "**/*.log", "**/*.yml", "**/*.save.json", "**/_game-entry-shot.png", "**/_ingame*.png", ".claude/**", "output/**", "_audit_deadhandlers.py", "analyze_globals.py", "detect_globals.js", "scan_globals.js", "final_scan.sh", "scan.sh", "start-server.bat", "tm-tools.d.ts", "types.d.ts", "maps/**", "data/maps/tianqi-ming2/tianqi-ming2.preview-data.js", "preview-launch*.html", "preview-launch-assets/**", "assets/ui/home/home-menu-imperial-study-v1-ambient.gif", "preview/shots/**", "preview/**/*verify*.png", "preview/home-ui-concepts/**", "preview/workshop-ui-concepts/**"],
